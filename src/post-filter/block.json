{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fieldnote-interactive/post-filter",
	"version": "1.0.0",
	"title": "Filterable Post Grid",
	"category": "widgets",
	"icon": "filter",
	"description": "A grid of posts with category filters and pagination that update in place, without a page reload. Falls back to normal links when JavaScript is unavailable.",
	"keywords": [
		"posts",
		"filter",
		"category",
		"grid",
		"blog"
	],
	"textdomain": "fieldnote-interactive",
	"attributes": {
		"postsPerPage": {
			"type": "number",
			"default": 6
		},
		"showExcerpt": {
			"type": "boolean",
			"default": true
		},
		"showSaveButton": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"interactivity": true,
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js"
}
